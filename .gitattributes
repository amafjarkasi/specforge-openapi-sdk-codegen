# Normalize line endings to LF for all source files. Windows checkouts
# convert to CRLF by default, which breaks parsers, formatters, and
# shebang lines. The spec parser also normalizes at read time, but
# keeping committed bytes stable across platforms avoids surprises.
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.rs   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.mts  text eol=lf
*.go   text eol=lf
*.mod  text eol=lf
*.sh   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.mdx  text eol=lf
*.md   text eol=lf

# Binary files: don't touch line endings.
*.png  binary
*.svg  text eol=lf
